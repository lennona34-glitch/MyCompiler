<Window x:Class="MyCompiler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="MyCompiler" Width="1440" Height="900" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#060B14" Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI" PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7" CornerRadius="11" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="OuterChromeBorder" BorderBrush="#4AFFFFFF" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
        <Grid AllowDrop="True" Drop="Root_Drop" DragOver="Root_DragOver">
            <Grid.Background>
                <ImageBrush ImageSource="/Assets/compiler-art.png" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
            </Grid.Background>
            <Rectangle Fill="#A8070D18" />

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="54" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="29" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#D2070C15" BorderBrush="#26FFFFFF" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="252" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                            <Border Width="31" Height="31" CornerRadius="9" Margin="0,0,10,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#7DEBFF" Offset="0" />
                                        <GradientStop Color="#4E6BFF" Offset="0.58" />
                                        <GradientStop Color="#9E62FF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="M" Foreground="#07101B" FontWeight="Black" FontSize="18"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="MyCompiler" FontWeight="Bold" FontSize="15" />
                                <TextBlock Text="UNIVERSAL WORKBENCH" Foreground="#71819B" FontSize="8" FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="TitlePathText" Grid.Column="1" Text="Untitled" Foreground="#8190A9"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,6,0">
                            <Button x:Name="FullScreenButton" Style="{StaticResource IconButton}" Content="⛶" BorderThickness="0" Background="Transparent"
                                    ToolTip="Toggle Full Screen (F11)" Click="FullScreenButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                            <Button Style="{StaticResource IconButton}" Content="—" BorderThickness="0" Background="Transparent"
                                    ToolTip="Minimize" Click="MinimizeButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                            <Button Style="{StaticResource IconButton}" Content="□" BorderThickness="0" Background="Transparent"
                                    ToolTip="Maximize" Click="MaximizeButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                            <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Content="×" BorderThickness="0" Background="Transparent"
                                    FontSize="20" ToolTip="Close" Click="CloseButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="252" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#D708111E" BorderBrush="#24FFFFFF" BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="WORKSPACE" Foreground="#7F8DA7" FontWeight="Bold" FontSize="10"
                                       Margin="18,17,18,10" />
                            <Grid Grid.Row="1" Margin="14,0,14,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="7" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource GlassButton}" Content="Open file" Click="OpenFileButton_Click" />
                                <Button Grid.Column="2" Style="{StaticResource GlassButton}" Content="Open folder" Click="OpenFolderButton_Click" />
                            </Grid>
                            <TextBox x:Name="ExplorerSearchBox" Grid.Row="2" Margin="14,0,14,8" FontSize="12"
                                     ToolTip="Filter files" TextChanged="ExplorerSearchBox_TextChanged" />
                            <ListBox x:Name="SourceExplorerList" Grid.Row="3" ItemsSource="{Binding Files}"
                                     BorderThickness="0" Background="Transparent" SelectionChanged="SourceExplorerList_SelectionChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ToolTip="{Binding FullPath}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="27" Height="23" CornerRadius="5" Background="#273E85FF"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Extension}" FontSize="8" FontWeight="Bold" Foreground="#9CE8FF"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding FileName}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding RelativePath}" FontSize="9" Foreground="#63718A" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border Grid.Row="4" BorderBrush="#20FFFFFF" BorderThickness="0,1,0,0" Padding="15,11">
                                <StackPanel>
                                    <TextBlock x:Name="WorkspaceNameText" Text="No folder open" FontSize="11" Foreground="#9CA9BD" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="FileCountText" Text="Drop a file or folder here" FontSize="9" Foreground="#5E6F8A" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="63" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="238" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#B90B1422" BorderBrush="#25FFFFFF" BorderThickness="0,0,0,1">
                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IconButton}" Content="＋" ToolTip="New file (Ctrl+N)" Click="NewFileButton_Click" />
                                    <Button Style="{StaticResource IconButton}" Content="↓" ToolTip="Save (Ctrl+S)" Margin="7,0,0,0" Click="SaveButton_Click" />
                                    <Border Background="#263F7DFF" BorderBrush="#384C9FFF" BorderThickness="1" CornerRadius="10"
                                            Padding="11,6" Margin="12,0,0,0">
                                        <TextBlock x:Name="LanguageBadgeText" Text="C# scratch" Foreground="#AEEBFF" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                                <TextBox x:Name="FindBox" Grid.Column="1" Width="210" HorizontalAlignment="Right" VerticalAlignment="Center"
                                         Margin="0,0,15,0" FontSize="11" ToolTip="Find in source (Ctrl+F)" KeyDown="FindBox_KeyDown" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="NewSessionButton" Style="{StaticResource GlassButton}" Content="⟲  New" Margin="0,0,8,0"
                                            ToolTip="Start fresh: clear the console, close the folder and reset the editor" Click="NewSessionButton_Click" />
                                    <Button x:Name="GitHubHubButton" Style="{StaticResource GlassButton}" Content="⚡  GitHub" Margin="0,0,8,0"
                                            Background="#2A3E78FF" BorderBrush="#649BFF"
                                            ToolTip="Browse GitHub Trending or paste any GitHub file/repo URL to install, build &amp; run automatically" Click="GitHubHubButton_Click" />
                                    <Button x:Name="AiStudioButton" Style="{StaticResource GlassButton}" Content="✨  AI Studio" Margin="0,0,8,0"
                                            Background="#33802090" BorderBrush="#B666FF" Foreground="#E2B3FF"
                                            ToolTip="AI Code Refactoring, Theme Overhauls &amp; Assistant (Ctrl+Shift+A)" Click="AiStudioButton_Click" />
                                    <Button x:Name="DecompileButton" Style="{StaticResource GlassButton}" Content="⇲  Decompile" Margin="0,0,8,0"
                                            ToolTip="Decompile an .exe, .dll, .apk or .jar (or drop one onto the window)" Click="DecompileButton_Click" />
                                    <Button x:Name="InstallSkillButton" Style="{StaticResource GlassButton}" Content="🤖  Install Skill" Margin="0,0,8,0"
                                            Background="#2A0E8A7A" BorderBrush="#3CE8D0" Foreground="#6AFFF0" Visibility="Collapsed"
                                            ToolTip="Install this skill to your personal Antigravity library (~/.gemini/config/skills/)" Click="InstallSkillButton_Click" />
                                    <Button x:Name="BuildButton" Style="{StaticResource GlassButton}" Content="Build  F6" Click="BuildButton_Click" />
                                    <Button x:Name="RunButton" Style="{StaticResource PrimaryButton}" Content="▶  Build &amp; run  F5" Margin="8,0,0,0" Click="RunButton_Click" />
                                    <Button x:Name="StopButton" Style="{StaticResource GlassButton}" Content="■" Width="42" Margin="8,0,0,0"
                                            IsEnabled="False" ToolTip="Stop" Click="StopButton_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="266" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Margin="12,12,7,10" CornerRadius="11" BorderBrush="#30FFFFFF" BorderThickness="1"
                                    Background="#D1060C15" ClipToBounds="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="38" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#B8111A2A" BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1">
                                        <Grid Margin="14,0">
                                            <TextBlock x:Name="EditorTabText" Text="welcome.cs" VerticalAlignment="Center" FontSize="11" Foreground="#DDE6F5" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Ellipse x:Name="DirtyDot" Width="7" Height="7" Fill="#FFB86B" Visibility="Collapsed" Margin="0,0,8,0" />
                                                <TextBlock Text="UTF-8" Foreground="#5F6E86" FontSize="9" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="47" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#7A09111E" BorderBrush="#1FFFFFFF" BorderThickness="0,0,1,0">
                                            <ScrollViewer x:Name="LineNumberScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                                                          IsHitTestVisible="False">
                                                <TextBlock x:Name="LineNumbersText" Text="1" FontFamily="Cascadia Mono, Consolas" FontSize="14"
                                                           Foreground="#45536B" TextAlignment="Right" Margin="0,11,9,40" />
                                            </ScrollViewer>
                                        </Border>
                                        <TextBox x:Name="SourceEditor" Grid.Column="1" AcceptsReturn="True" AcceptsTab="True"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                 TextWrapping="NoWrap" FontFamily="Cascadia Code, Cascadia Mono, Consolas" FontSize="14"
                                                 Padding="14,10,20,50" Background="#72040A12" BorderThickness="0"
                                                 TextChanged="SourceEditor_TextChanged" SelectionChanged="SourceEditor_SelectionChanged" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Margin="7,12,12,10" CornerRadius="11" BorderBrush="#30FFFFFF" BorderThickness="1"
                                    Background="#D20B1422" ClipToBounds="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="52" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="14,0">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="TOOLCHAINS" FontSize="10" FontWeight="Bold" Foreground="#8594AD" />
                                            <TextBlock x:Name="ToolchainSummaryText" Text="Scanning this PC…" FontSize="9" Foreground="#586981" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Style="{StaticResource IconButton}" Content="PATH" Width="44" Height="29" FontSize="8"
                                                    ToolTip="Run the read-only PATH Doctor" Click="PathDoctorButton_Click" />
                                            <Button Style="{StaticResource IconButton}" Content="↻" Width="31" Height="29" Margin="5,0,0,0"
                                                    ToolTip="Refresh toolchains" Click="RefreshToolchainsButton_Click" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Grid.Row="1" Margin="12,0,12,9" CornerRadius="8" Background="#162FE06F" BorderBrush="#263FE889" BorderThickness="1" Padding="9,7">
                                        <TextBlock Text="MyCompiler uses the compilers already installed on your PC." Foreground="#8EDCAB" FontSize="9" TextWrapping="Wrap" />
                                    </Border>
                                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Toolchains}" Margin="9,0,9,10">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="7" Padding="8,7" Margin="0,1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#0CFFFFFF" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                                        <Setter Property="Background" Value="#1228D97A" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Margin="0,0,7,0">
                                                                <TextBlock Text="{Binding Name}" Foreground="#D6DDEA" FontSize="10" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding Tool}" Foreground="#71809A" FontSize="8" Margin="0,2,0,0"
                                                                           ToolTip="{Binding ResolvedPath}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Detail}" Foreground="#52627A" FontSize="8" Margin="0,2,0,0" TextWrapping="Wrap" />

                                                                <!-- Shown when toolchain is installed and up-to-date -->
                                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding ReadyBadgeVisibility}">
                                                                    <TextBlock Text="✓ Ready &amp; up-to-date" Foreground="#4AE28D" FontSize="8" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                </StackPanel>

                                                                <!-- Shown ONLY when toolchain is not yet installed -->
                                                                <Border Background="#14000000" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="5"
                                                                        Padding="5,4" Margin="0,5,0,0" Visibility="{Binding CommandBoxVisibility}">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding SuggestedCommand}" Foreground="#8090A8" FontFamily="Cascadia Mono, Consolas"
                                                                                   FontSize="7" TextWrapping="Wrap" ToolTip="{Binding SuggestedCommand}" />
                                                                        <Button Grid.Column="1" Style="{StaticResource GlassButton}" Content="{Binding ActionLabel}"
                                                                                Tag="{Binding SuggestedCommand}" Click="CopyToolchainCommandButton_Click"
                                                                                FontSize="7" Padding="6,3" Margin="5,0,0,0" VerticalAlignment="Center" />
                                                                    </Grid>
                                                                </Border>
                                                            </StackPanel>
                                                            <Border Grid.Column="1" Width="8" Height="8" CornerRadius="4" VerticalAlignment="Top" Margin="0,4,0,0">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#435065" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                                                <Setter Property="Background" Value="#45E18D" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border Grid.Row="2" Margin="12,0,12,12" CornerRadius="11" BorderBrush="#30FFFFFF" BorderThickness="1"
                                Background="#E2060B13" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="41" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="40" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#B9121B2A" BorderBrush="#20FFFFFF" BorderThickness="0,0,0,1">
                                    <Grid Margin="13,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="OutputStatusDot" Width="8" Height="8" Fill="#5B6980" Margin="0,0,9,0" />
                                            <TextBlock Text="BUILD OUTPUT" FontSize="10" FontWeight="Bold" Foreground="#8998B0" />
                                            <TextBlock x:Name="OutputSummaryText" Text="Ready" FontSize="9" Foreground="#52627A" Margin="10,0,0,0" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Style="{StaticResource IconButton}" Content="Copy" Width="48" Height="27" FontSize="9" Click="CopyOutputButton_Click" />
                                            <Button Style="{StaticResource IconButton}" Content="Clear" Width="48" Height="27" FontSize="9" Margin="6,0,0,0" Click="ClearOutputButton_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBox x:Name="OutputBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0"
                                         Background="#A002070D" Foreground="#B9C9DD" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                         Padding="13,9" />
                                <Grid Grid.Row="2" Background="#8A0D1522">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&gt;_" Foreground="#64DBFF" FontFamily="Consolas" FontWeight="Bold"
                                               Margin="13,0,9,0" VerticalAlignment="Center" />
                                    <TextBox x:Name="CustomCommandBox" Grid.Column="1" BorderThickness="0" Background="Transparent" Padding="4,5"
                                             FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                             ToolTip="Type 'install' (add SKILL.md to Antigravity), 'exe' (launch best .exe in folder), 'exes' (list all .exe files), 'help', or any shell command"
                                             KeyDown="CustomCommandBox_KeyDown" />
                                    <TextBlock Grid.Column="2" Text="try: install · exe · exes · help" Foreground="#4A5A72" FontSize="9"
                                               FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center" Margin="6,0,6,0" IsHitTestVisible="False" />
                                    <Button Grid.Column="3" Style="{StaticResource GlassButton}" Content="Run command" Margin="4,5,7,5"
                                            Padding="12,3" FontSize="10" Click="RunCustomCommandButton_Click" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- GitHub Hub Modal Drawer Overlay -->
                    <Border x:Name="GitHubOverlay" Grid.ColumnSpan="2" Background="#D8040811" Visibility="Collapsed"
                            MouseLeftButtonDown="GitHubOverlay_BackdropClick">
                        <Border x:Name="GitHubModalCard" MaxWidth="1420" MaxHeight="860" Margin="20" CornerRadius="14" BorderBrush="#4879B8FF" BorderThickness="1"
                                Background="#F4091220" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                MouseLeftButtonDown="GitHubModalCard_MouseLeftButtonDown" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Modal Header -->
                                <Border Grid.Row="0" Background="#B8101C30" BorderBrush="#26FFFFFF" BorderThickness="0,0,0,1" Padding="20,14">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="30" Height="30" CornerRadius="8" Background="#2D4A9EFF" BorderBrush="#64A5FF" BorderThickness="1" Margin="0,0,12,0">
                                                <TextBlock Text="⚡" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="GitHub Instant Fetch, Build &amp; Run" FontSize="15" FontWeight="Bold" Foreground="#F2F7FF" />
                                                <TextBlock Text="Paste any GitHub repository, source file, or Gist — or pick from Trending below. Zero command-line needed."
                                                           FontSize="10" Foreground="#8395B2" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Style="{StaticResource IconButton}" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                ToolTip="Close GitHub Hub (Esc)" Click="CloseGitHubOverlay_Click" />
                                    </Grid>
                                </Border>

                                <!-- Direct GitHub URL / Repo / Search Bar -->
                                <Border Grid.Row="1" Background="#7A0B1526" BorderBrush="#20FFFFFF" BorderThickness="0,0,0,1" Padding="20,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <TextBox x:Name="GitHubUrlBox" FontSize="12" Padding="12,9"
                                                     ToolTip="Paste a GitHub URL, owner/repo shorthand, OR type any search keyword (e.g. 'Antigravity', 'Zelda64Recomp') and press Enter"
                                                     KeyDown="GitHubUrlBox_KeyDown" />
                                            <TextBlock Text="Paste GitHub URL / owner/repo — OR type any search keyword (e.g. Antigravity, N64Recomp) &amp; press Enter…"
                                                       Foreground="#556680" FontSize="11" Margin="14,0,0,0" VerticalAlignment="Center"
                                                       IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=GitHubUrlBox}" Value="">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <Button Grid.Column="1" Style="{StaticResource GlassButton}" Content="↓  Fetch &amp; Open" Margin="10,0,0,0"
                                                ToolTip="Download into MyCompiler workspace without running immediately (or search if a keyword is typed)"
                                                Click="GitHubFetchOnlyButton_Click" />
                                        <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="▶  Install, Build &amp; Run" Margin="8,0,0,0"
                                                ToolTip="Automatically download, classify, build (or grab Windows release binary), and launch"
                                                Click="GitHubInstallAndRunUrlButton_Click" />
                                    </Grid>
                                </Border>

                                <!-- Trending & Category Feed Filter Bar -->
                                <Border Grid.Row="2" Padding="18,10" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: Feeds (Left) + Hide Downloaded Toggle & Search (Right) -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="FEED" FontSize="10" FontWeight="Bold" Foreground="#7CE8FF" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <Button x:Name="TrendDailyBtn" Style="{StaticResource GlassButton}" Content="Today" Padding="8,5" FontSize="10" Tag="daily" Click="TrendingSinceButton_Click" />
                                                <Button x:Name="TrendWeeklyBtn" Style="{StaticResource GlassButton}" Content="Week" Padding="8,5" FontSize="10" Margin="4,0,0,0" Tag="weekly" Click="TrendingSinceButton_Click" />
                                                <Button x:Name="TrendMonthlyBtn" Style="{StaticResource GlassButton}" Content="Month" Padding="8,5" FontSize="10" Margin="4,0,0,0" Tag="monthly" Click="TrendingSinceButton_Click" />
                                                <Button x:Name="WindowsAppsBtn" Style="{StaticResource GlassButton}" Content="★ Windows Apps" Padding="9,5" FontSize="10" Margin="5,0,0,0"
                                                        Background="#261B8A5A" BorderBrush="#45E18D"
                                                        ToolTip="Show runnable Windows desktop apps, tools &amp; games on GitHub"
                                                        Click="WindowsAppsFeedButton_Click" />
                                                <Button x:Name="RecompPortsBtn" Style="{StaticResource GlassButton}" Content="⚡ Recomp" Padding="9,5" FontSize="10" Margin="5,0,0,0"
                                                        Background="#2B6B22A8" BorderBrush="#B666FF"
                                                        ToolTip="Show Static Recompilation game ports (N64Recomp, Zelda64Recomp, Majora's Mask, PS2Recomp, XenonRecomp, B2recomp, etc.)"
                                                        Click="RecompFeedButton_Click" />
                                                <Button x:Name="DecompProjectsBtn" Style="{StaticResource GlassButton}" Content="🎮 Decomp" Padding="9,5" FontSize="10" Margin="5,0,0,0"
                                                        Background="#2EC85A17" BorderBrush="#FF9248"
                                                        ToolTip="Show Game Decompilations &amp; Reverse-Engineered Source Ports (SM64, Pokeemerald, Sonic, Ship of Harkinian, OpenGOAL, etc.)"
                                                        Click="DecompFeedButton_Click" />
                                                <Button x:Name="AntigravityMcpBtn" Style="{StaticResource GlassButton}" Content="🤖 Antigravity / MCP" Padding="9,5" FontSize="10" Margin="5,0,0,0"
                                                        Background="#2E0E8A7A" BorderBrush="#3CE8D0"
                                                        ToolTip="Show Antigravity skills, plugins &amp; MCP servers"
                                                        Click="AntigravityMcpFeedButton_Click" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                                <Button x:Name="HideDownloadedButton" Style="{StaticResource GlassButton}"
                                                        Content="🙈 Hidden" Padding="10,5" FontSize="10" FontWeight="SemiBold"
                                                        Foreground="#4AE28D" Background="#33104B80" BorderBrush="#45E18D"
                                                        Click="HideDownloadedButton_Click"
                                                        ToolTip="Toggle hiding repositories that have already been downloaded to keep results fresh" />
                                                <Grid Width="170" Margin="8,0,0,0">
                                                    <TextBox x:Name="GitHubSearchBox" FontSize="11" Padding="8,5"
                                                             ToolTip="Search GitHub repositories by topic or keyword (press Enter)"
                                                             KeyDown="GitHubSearchBox_KeyDown" />
                                                    <TextBlock Text="Filter / search…" Foreground="#52627C" FontSize="10"
                                                               Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Text, ElementName=GitHubSearchBox}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                                <Button Style="{StaticResource GlassButton}" Content="Search" Padding="10,5" FontSize="10" Margin="5,0,0,0"
                                                        Click="GitHubSearchButton_Click" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Row 1: Language Filter Pills -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                                            <TextBlock Text="LANG:" FontSize="10" FontWeight="Bold" Foreground="#7A8AA6" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Button Style="{StaticResource GlassButton}" Content="All" Padding="7,4" FontSize="10" Tag="all" Click="TrendingLangButton_Click" />
                                            <Button Style="{StaticResource GlassButton}" Content="C#" Padding="7,4" FontSize="10" Margin="3,0,0,0" Tag="c#" Click="TrendingLangButton_Click" />
                                            <Button Style="{StaticResource GlassButton}" Content="Python" Padding="7,4" FontSize="10" Margin="3,0,0,0" Tag="python" Click="TrendingLangButton_Click" />
                                            <Button Style="{StaticResource GlassButton}" Content="Rust" Padding="7,4" FontSize="10" Margin="3,0,0,0" Tag="rust" Click="TrendingLangButton_Click" />
                                            <Button Style="{StaticResource GlassButton}" Content="Go" Padding="7,4" FontSize="10" Margin="3,0,0,0" Tag="go" Click="TrendingLangButton_Click" />
                                            <Button Style="{StaticResource GlassButton}" Content="C++" Padding="7,4" FontSize="10" Margin="3,0,0,0" Tag="c++" Click="TrendingLangButton_Click" />
                                            <Button Style="{StaticResource GlassButton}" Content="TS/JS" Padding="7,4" FontSize="10" Margin="3,0,0,0" Tag="typescript" Click="TrendingLangButton_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Trending / Search Repository Cards -->
                                <Grid Grid.Row="3">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
                                        <ItemsControl ItemsSource="{Binding TrendingRepos}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="10" Background="#12FFFFFF" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1"
                                                            Padding="14,11" Margin="0,0,0,9">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding FullName}" FontSize="13" FontWeight="Bold" Foreground="#EAF2FF" VerticalAlignment="Center" />
                                                                    <!-- Downloaded Green Pill Badge -->
                                                                    <Border Background="#2034D399" BorderBrush="#34D399" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="9,0,0,0"
                                                                            VerticalAlignment="Center" Visibility="{Binding DownloadedVisibility}">
                                                                        <TextBlock Text="✓ DOWNLOADED" FontSize="9" FontWeight="Bold" Foreground="#4AE28D" />
                                                                    </Border>
                                                                    <Border Background="{Binding CategoryColor}" CornerRadius="6" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding CategoryHint}" FontSize="9" FontWeight="SemiBold" Foreground="#E5F1FF" />
                                                                    </Border>
                                                                    <Border Background="#1CFFFFFF" CornerRadius="6" Padding="7,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Language}" FontSize="9" Foreground="#9CE8FF" FontWeight="SemiBold" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#9AA9C2" TextWrapping="Wrap" Margin="0,5,0,6" />
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding StarsText}" FontSize="10" Foreground="#FFD166" FontWeight="SemiBold" />
                                                                    <TextBlock Text="  ·  " FontSize="10" Foreground="#53637C" />
                                                                    <TextBlock Text="{Binding PeriodStarsText}" FontSize="10" Foreground="#6AE39C" />
                                                                    <TextBlock Text="  ·  " FontSize="10" Foreground="#53637C" />
                                                                    <TextBlock Text="{Binding HtmlUrl}" FontSize="10" Foreground="#60718D" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Button Style="{StaticResource GlassButton}" Content="{Binding DownloadButtonText}" Padding="10,7" FontSize="10"
                                                                        Tag="{Binding HtmlUrl}" Click="TrendingCardOpenOnly_Click"
                                                                        ToolTip="{Binding DownloadButtonTooltip}" />
                                                                <Button Style="{StaticResource PrimaryButton}" Content="⚡ Install &amp; Run" Padding="12,7" FontSize="10"
                                                                        Margin="7,0,0,0" Tag="{Binding HtmlUrl}" Click="TrendingCardInstallRun_Click"
                                                                        ToolTip="Automated download, project detection, build (or release EXE fallback), and launch" />
                                                                <Button Style="{StaticResource GlassButton}" Content="✓" Padding="8,7" FontSize="11" Margin="6,0,0,0"
                                                                        Foreground="{Binding CheckmarkBrush}" Tag="{Binding}" Click="ToggleMarkDownloaded_Click"
                                                                        ToolTip="{Binding CheckmarkTooltip}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>

                                <!-- Modal Footer Status & Download Location -->
                                <Border Grid.Row="4" Background="#B80C1524" BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0" Padding="18,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📁 Download to:" FontSize="10" Foreground="#889AB5" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock x:Name="GitHubDownloadFolderText" Text="C:\Users\adria\Desktop\MyCompiler\Downloads" FontSize="10" Foreground="#7DEBFF" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                                            <Button Style="{StaticResource GlassButton}" Content="Change…" Padding="8,3" FontSize="9" Click="ChangeDownloadFolder_Click" ToolTip="Choose a custom folder on your PC for downloaded GitHub repositories &amp; files" />
                                            <Button Style="{StaticResource GlassButton}" Content="Open Folder ↗" Margin="5,0,0,0" Padding="8,3" FontSize="9" Click="OpenDownloadFolder_Click" ToolTip="Open the downloads folder in Windows File Explorer" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" x:Name="GitHubModalStatusText" Text="Select a Trending repository or paste any GitHub URL above."
                                                   FontSize="10" Foreground="#889AB5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Border>

                    <!-- AI Studio Modal Drawer Overlay -->
                    <Border x:Name="AiStudioOverlay" Grid.ColumnSpan="2" Background="#DD040811" Visibility="Collapsed"
                            MouseLeftButtonDown="AiStudioOverlay_BackdropClick">
                        <Border x:Name="AiStudioModalCard" MaxWidth="1680" MaxHeight="980" Margin="20" CornerRadius="14" BorderBrush="#55B666FF" BorderThickness="1"
                                Background="#F60A101C" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                MouseLeftButtonDown="AiStudioModalCard_MouseLeftButtonDown" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Row 0: Modal Header -->
                                <Border Grid.Row="0" Background="#C4131A2B" BorderBrush="#26FFFFFF" BorderThickness="0,0,0,1" Padding="20,13">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="30" Height="30" CornerRadius="8" Background="#33802090" BorderBrush="#B666FF" BorderThickness="1" Margin="0,0,12,0">
                                                <TextBlock Text="✨" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="MyCompiler AI Studio" FontSize="15" FontWeight="Bold" Foreground="#F5F8FF" />
                                                <TextBlock Text="Refactor open source code · Overhaul UI themes &amp; colors · Fix compiler errors · Fork &amp; advance repos"
                                                           FontSize="10" Foreground="#A89AB8" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="AiSettingsToggleButton" Style="{StaticResource GlassButton}"
                                                    Content="⚙️ AI Settings" Padding="10,5" FontSize="10" Margin="0,0,8,0"
                                                    Click="AiSettingsToggleButton_Click"
                                                    ToolTip="Configure API URL, API Key &amp; Model (Google Gemini, OpenAI, OpenRouter, Ollama, DeepSeek, Groq)" />
                                            <Button x:Name="AiStudioMaximizeButton" Style="{StaticResource IconButton}" Content="⛶" Width="32" Height="30" Margin="0,0,6,0"
                                                    ToolTip="Maximize AI Studio to full window (or restore)" Click="AiStudioMaximizeButton_Click" />
                                            <Button Style="{StaticResource IconButton}" Content="✕" Width="32" Height="30"
                                                    ToolTip="Close AI Studio (Esc)" Click="CloseAiStudioOverlay_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Row 1: Quick Action Chips -->
                                <Border Grid.Row="1" Background="#50070F1A" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1" Padding="20,8">
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="PROMPTS:" FontSize="9" FontWeight="Bold" Foreground="#8592A8" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Button Style="{StaticResource GlassButton}" Content="⚡ Refactor Code" Padding="9,4" FontSize="10" Margin="0,2,5,2"
                                                Background="#22802090" BorderBrush="#9A45D8"
                                                ToolTip="Refactor open-source code for clean architecture, modern idioms, and performance"
                                                Click="QuickAction_Refactor_Click" />
                                        <Button Style="{StaticResource GlassButton}" Content="💙 Make Neon Blue" Padding="9,4" FontSize="10" Margin="0,2,5,2"
                                                Background="#2000A8FF" BorderBrush="#00D2FF" Foreground="#7DEBFF"
                                                ToolTip="Transform all orange/warm UI accents, borders &amp; highlights into glowing electric neon blue and cyan"
                                                Click="QuickAction_NeonBlue_Click" />
                                        <Button Style="{StaticResource GlassButton}" Content="🌙 Give Dark Mode" Padding="9,4" FontSize="10" Margin="0,2,5,2"
                                                Background="#221C2B44" BorderBrush="#5070A0"
                                                ToolTip="Convert this UI to sleek modern glassmorphism dark mode with deep navy/black backgrounds"
                                                Click="QuickAction_DarkMode_Click" />
                                        <Button Style="{StaticResource GlassButton}" Content="🔤 Modern Font" Padding="9,4" FontSize="10" Margin="0,2,5,2"
                                                Background="#20104B80" BorderBrush="#358AC4"
                                                ToolTip="Update typography to Cascadia Code / Segoe UI Variable / JetBrains Mono"
                                                Click="QuickAction_Font_Click" />
                                        <Button Style="{StaticResource GlassButton}" Content="🐛 Fix Build Error" Padding="9,4" FontSize="10" Margin="0,2,5,2"
                                                Background="#258A2020" BorderBrush="#E05555" Foreground="#FFAAAA"
                                                ToolTip="Automatically pulls the latest compile error from Output console and prompts AI to repair it"
                                                Click="QuickAction_FixError_Click" />
                                        <Button Style="{StaticResource GlassButton}" Content="📖 Explain Code" Padding="9,4" FontSize="10" Margin="0,2,5,2"
                                                Background="#18FFFFFF" BorderBrush="#33FFFFFF"
                                                ToolTip="Explain this file, algorithm, or decompiled module in plain English"
                                                Click="QuickAction_Explain_Click" />
                                        <Button Style="{StaticResource GlassButton}" Content="🔀 Git Fork &amp; Push" Padding="9,4" FontSize="10" Margin="0,2,5,2"
                                                Background="#242E6B3E" BorderBrush="#4AE28D" Foreground="#6AF5A5"
                                                ToolTip="Review Git status, generate conventional commit message, and push your fork to GitHub"
                                                Click="QuickAction_GitFork_Click" />
                                    </WrapPanel>
                                </Border>

                                <!-- Row 2: Two-column Main Workspace with Resizable Splitter -->
                                <Grid Grid.Row="2" Margin="18,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="420" MinWidth="320" MaxWidth="700" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" MinWidth="400" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Side: Context Card, Prompt Input, Settings Panel, Git Panel -->
                                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
                                        <StackPanel>
                                            <!-- Target File & Context Status Card -->
                                            <Border CornerRadius="8" Background="#16FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" Padding="12,10" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <Grid>
                                                        <TextBlock Text="TARGET CONTEXT" FontSize="9" FontWeight="Bold" Foreground="#8592A8" />
                                                        <TextBlock x:Name="AiContextScopeText" Text="Full file" HorizontalAlignment="Right" FontSize="9" Foreground="#66D9FF" />
                                                    </Grid>
                                                    <TextBlock x:Name="AiTargetFileText" Text="welcome.cs" FontSize="11" FontWeight="SemiBold" Foreground="#F0F4FC" Margin="0,4,0,2" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock x:Name="AiSelectionStatusText" Text="Entire file (no selection)" FontSize="9" Foreground="#7A8CA6" />
                                                    <TextBlock x:Name="AiErrorStatusText" Text="Build output: Clean" FontSize="9" Foreground="#52627A" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Collapsible Settings Panel -->
                                            <Border x:Name="AiSettingsPanel" CornerRadius="8" Background="#22111E32" BorderBrush="#40B666FF" BorderThickness="1"
                                                    Padding="12,11" Margin="0,0,0,10" Visibility="Collapsed">
                                                <StackPanel>
                                                    <TextBlock Text="AI PROVIDER &amp; API CONFIGURATION" FontSize="9" FontWeight="Bold" Foreground="#C766FF" Margin="0,0,0,8" />

                                                    <TextBlock Text="Provider Preset" FontSize="9" Foreground="#8594AD" Margin="0,0,0,3" />
                                                    <ComboBox x:Name="AiProviderCombo" FontSize="10" Padding="6,4" Margin="0,0,0,7" SelectionChanged="AiProviderCombo_SelectionChanged" />

                                                    <TextBlock Text="API Endpoint URL" FontSize="9" Foreground="#8594AD" Margin="0,0,0,3" />
                                                    <TextBox x:Name="AiApiUrlBox" FontSize="10" Padding="6,4" Margin="0,0,0,7"
                                                             ToolTip="OpenAI-compatible URL (e.g. https://api.openai.com/v1/chat/completions or http://localhost:11434/v1/chat/completions)" />

                                                    <Grid Margin="0,0,0,3">
                                                        <TextBlock Text="API Key" FontSize="9" Foreground="#8594AD" VerticalAlignment="Center" />
                                                        <Button x:Name="AiGetKeyLinkButton" Style="{StaticResource GlassButton}"
                                                                Content="Get Free API Key ↗" HorizontalAlignment="Right"
                                                                Padding="6,1" FontSize="8" Foreground="#66D9FF" BorderBrush="#3066D9FF"
                                                                ToolTip="Open provider website to create or copy your API key"
                                                                Click="AiGetKeyLinkButton_Click" />
                                                    </Grid>
                                                    <Grid Margin="0,0,0,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <PasswordBox x:Name="AiApiKeyBox" Grid.Column="0" FontSize="10" Padding="6,4" />
                                                        <TextBox x:Name="AiApiKeyPlainBox" Grid.Column="0" FontSize="10" Padding="6,4" Visibility="Collapsed" />
                                                        <Button x:Name="AiToggleKeyVisButton" Grid.Column="1" Style="{StaticResource GlassButton}" Content="👁"
                                                                Padding="7,2" FontSize="10" Margin="4,0,0,0" Click="AiToggleKeyVisibility_Click" />
                                                    </Grid>
                                                    <TextBlock x:Name="AiEnvDetectedText" Text="" FontSize="8" Foreground="#4AE28D" Margin="0,0,0,6"
                                                               Visibility="Collapsed" Cursor="Hand" MouseLeftButtonDown="AiEnvDetectedText_Click"
                                                               ToolTip="Click to automatically use this detected API key" />

                                                    <TextBlock Text="Model Name" FontSize="9" Foreground="#8594AD" Margin="0,0,0,3" />
                                                    <TextBox x:Name="AiModelBox" FontSize="10" Padding="6,4" Margin="0,0,0,4"
                                                             ToolTip="Model ID (e.g. gemini-3.8-flash, gemini-3.8-pro, gpt-4o, deepseek-chat)" />
                                                    <WrapPanel x:Name="AiModelSuggestionsPanel" Margin="0,0,0,9" Orientation="Horizontal" />

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Button Grid.Column="0" Style="{StaticResource GlassButton}" Content="Ping Connection"
                                                                Padding="8,4" FontSize="9" Margin="0,0,4,0" Click="AiTestPing_Click" />
                                                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Save Settings"
                                                                Padding="8,4" FontSize="9" Margin="4,0,0,0" Click="AiSaveSettings_Click" />
                                                    </Grid>
                                                    <TextBlock x:Name="AiPingStatusText" Text="" FontSize="9" Foreground="#66D9FF" Margin="0,6,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Collapsible Git Fork & Commit Panel -->
                                            <Border x:Name="AiGitForkPanel" CornerRadius="8" Background="#1D12261C" BorderBrush="#404AE28D" BorderThickness="1"
                                                    Padding="12,11" Margin="0,0,0,10" Visibility="Collapsed">
                                                <StackPanel>
                                                    <TextBlock Text="GIT FORK &amp; COMMIT HELPER" FontSize="9" FontWeight="Bold" Foreground="#4AE28D" Margin="0,0,0,8" />
                                                    <TextBlock x:Name="AiGitBranchText" Text="Branch: main" FontSize="10" Foreground="#D5F7E4" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="AiGitStatusText" Text="Scanning git workspace…" FontSize="9" Foreground="#85AB95" Margin="0,2,0,7" TextWrapping="Wrap" />

                                                    <TextBlock Text="Commit message" FontSize="9" Foreground="#8594AD" Margin="0,0,0,3" />
                                                    <Grid Margin="0,0,0,8">
                                                        <TextBox x:Name="AiGitCommitMsgBox" FontSize="10" Padding="6,4" Text="refactor: modern code cleanup and theme overhaul" />
                                                    </Grid>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Button Grid.Column="0" Style="{StaticResource GlassButton}" Content="✨ AI Message"
                                                                Padding="8,4" FontSize="9" Margin="0,0,5,0" Click="AiSuggestCommitMsg_Click" />
                                                        <Button Grid.Column="1" Style="{StaticResource GlassButton}" Content="Commit &amp; Push"
                                                                Background="#2E237E44" BorderBrush="#4AE28D" Foreground="#E0FFE9"
                                                                Padding="8,4" FontSize="9" Click="AiGitCommitPush_Click" />
                                                        <Button Grid.Column="2" Style="{StaticResource GlassButton}" Content="GitHub ↗"
                                                                Padding="8,4" FontSize="9" Margin="5,0,0,0" Click="AiGitOpenBrowser_Click" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- Prompt Input Card -->
                                            <TextBlock Text="YOUR INSTRUCTION / PROMPT" FontSize="9" FontWeight="Bold" Foreground="#8592A8" Margin="0,0,0,5" />
                                            <TextBox x:Name="AiPromptBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="130" Height="150" FontSize="11" Padding="9,7"
                                                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,8" KeyDown="AiPromptBox_KeyDown"
                                                     ToolTip="Enter your instruction. Press Ctrl+Enter to generate." />

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="AiGenerateButton" Grid.Column="0" Style="{StaticResource PrimaryButton}"
                                                        Content="▶  Generate &amp; Refactor" Padding="14,8" FontSize="11"
                                                        Background="#3B802090" BorderBrush="#C766FF" Foreground="#FFFFFF"
                                                        Click="AiGenerateButton_Click" />
                                                <Button x:Name="AiStopButton" Grid.Column="1" Style="{StaticResource GlassButton}"
                                                        Content="■ Stop" Padding="12,8" FontSize="11" Margin="6,0,0,0" IsEnabled="False"
                                                        Click="AiStopButton_Click" />
                                            </Grid>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <!-- Draggable Splitter -->
                                    <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                                  Background="#20FFFFFF" Cursor="SizeWE" />

                                    <!-- Right Side: AI Response Viewer and Code Actions -->
                                    <Border Grid.Column="2" CornerRadius="10" Background="#12050B14" BorderBrush="#25FFFFFF" BorderThickness="1" ClipToBounds="True">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="38" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <!-- Response Header Bar -->
                                            <Border Grid.Row="0" Background="#90111A29" BorderBrush="#20FFFFFF" BorderThickness="0,0,0,1" Padding="12,0">
                                                <Grid>
                                                    <TextBlock Text="PROPOSED CODE &amp; EXPLANATION" FontSize="10" FontWeight="Bold" Foreground="#899AB5" VerticalAlignment="Center" />

                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button x:Name="AiUndoCodeButton" Style="{StaticResource GlassButton}" Content="↩ Undo Edit"
                                                                Padding="8,3" FontSize="9" Margin="0,0,6,0" Visibility="Collapsed" Click="AiUndoCodeButton_Click"
                                                                ToolTip="Revert back to the code before the AI edit was applied" />
                                                        <Button x:Name="AiApplyCodeButton" Style="{StaticResource PrimaryButton}" Content="⚡ Apply to Code"
                                                                Background="#3045E18D" BorderBrush="#45E18D" Foreground="#A2FFC8"
                                                                Padding="10,4" FontSize="9" FontWeight="Bold" IsEnabled="False"
                                                                Click="AiApplyCodeButton_Click" ToolTip="Replace active code (or selection) with the AI's generated code" />
                                                        <Button x:Name="AiCopyCodeButton" Style="{StaticResource GlassButton}" Content="📋 Copy"
                                                                Padding="8,4" FontSize="9" Margin="6,0,0,0" IsEnabled="False"
                                                                Click="AiCopyCodeButton_Click" ToolTip="Copy extracted code to clipboard" />
                                                        <Button x:Name="AiSaveNewFileButton" Style="{StaticResource GlassButton}" Content="💾 Save New File"
                                                                Padding="8,4" FontSize="9" Margin="6,0,0,0" IsEnabled="False"
                                                                Click="AiSaveNewFileButton_Click" ToolTip="Save this code as a new file in workspace" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Response Text Viewer -->
                                            <TextBox x:Name="AiResponseBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0"
                                                     Background="#5002070D" Foreground="#D5E4F8"
                                                     FontFamily="Cascadia Code, Cascadia Mono, Consolas" FontSize="12" Padding="14,10" />
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Row 3: Modal Footer Status -->
                                <Border Grid.Row="3" Background="#B80C1422" BorderBrush="#20FFFFFF" BorderThickness="0,1,0,0" Padding="18,8">
                                    <Grid>
                                        <TextBlock x:Name="AiStatusText" Text="Ready. Click any quick prompt above or type your instruction."
                                                   FontSize="10" Foreground="#8592A8" VerticalAlignment="Center" />
                                        <TextBlock x:Name="AiModelInfoText" Text="OpenAI · gpt-4o"
                                                   FontSize="9" Foreground="#66D9FF" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Background="#EC07101B" BorderBrush="#20FFFFFF" BorderThickness="0,1,0,0">
                    <Grid Margin="13,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="AppStatusDot" Width="7" Height="7" Fill="#4AE28D" Margin="0,0,8,0" />
                            <TextBlock x:Name="AppStatusText" Text="Ready" Foreground="#71819A" FontSize="9" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="CursorStatusText" Text="Ln 1, Col 1" Foreground="#65758F" FontSize="9" />
                            <TextBlock Text="  •  Windows x64  •  MyCompiler 1.4" Foreground="#44536B" FontSize="9" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
